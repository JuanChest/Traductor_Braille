<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.traductor.controller.TraductorController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Sistema Traductor Braille v1.3.0" />
    
    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
        <!-- Tab 1: Español a Braille -->
        <Tab text="Español ➡ Braille">
            <VBox spacing="15.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                
                <Label text="Texto de Entrada (Español):" />
                
                <TextArea fx:id="textoEntrada" prefColumnCount="40" prefRowCount="5" promptText="Escribe aquí para traducir..." wrapText="true" />
                
                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="btnLimpiar" onAction="#limpiarTexto" style="-fx-font-size: 14px; -fx-padding: 10px 20px;" text="Limpiar" />
                    <Button fx:id="btnTraducir" onAction="#traducir" style="-fx-font-size: 14px; -fx-padding: 10px 20px; -fx-background-color: #2196F3; -fx-text-fill: white;" text="Traducir" />
                </HBox>
                
                <Label text="Resultado (Braille):" />
                
                <TextArea fx:id="textoSalida" editable="false" prefColumnCount="40" prefRowCount="5" style="-fx-control-inner-background: #f0f0f0; -fx-font-size: 24px; -fx-font-family: 'Segoe UI Symbol', 'Arial Unicode MS', 'DejaVu Sans';" wrapText="true" />
                
                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #e3f2fd; -fx-padding: 10px; -fx-background-radius: 5px;">
                    <CheckBox fx:id="checkModoEspejo" text="Modo Espejo (Para escritura manual)" />
                    <Button fx:id="btnDescargarPDF" onAction="#descargarPDF" style="-fx-font-size: 12px; -fx-padding: 8px 15px; -fx-background-color: #4CAF50; -fx-text-fill: white;" text="Generar PDF" />
                </HBox>
            </VBox>
        </Tab>
        
        <!-- Tab 2: Braille a Español (Interactivo) -->
        <Tab text="Braille ➡ Español">
            <VBox fx:id="containerPestanaBraille" focusTraversable="true" spacing="15.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                
                <!-- SECCIÓN 1: Celda Braille Interactiva e Instrucciones -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Ingresa símbolos Braille:" />
                
                <HBox alignment="CENTER" spacing="20.0">
                    <!-- Celda Braille -->
                    <GridPane alignment="CENTER" hgap="20.0" prefHeight="231.0" prefWidth="470.0" style="-fx-background-color: #F5F5F5; -fx-padding: 20px; -fx-background-radius: 10px;" vgap="20.0">
                        <!-- Columna izquierda: Puntos 1, 2, 3 -->
                        <CheckBox fx:id="chkPunto1" focusTraversable="false" style="-fx-min-width: 50px; -fx-min-height: 50px; -fx-max-width: 50px; -fx-max-height: 50px;" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <CheckBox fx:id="chkPunto2" focusTraversable="false" style="-fx-min-width: 50px; -fx-min-height: 50px; -fx-max-width: 50px; -fx-max-height: 50px;" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <CheckBox fx:id="chkPunto3" focusTraversable="false" style="-fx-min-width: 50px; -fx-min-height: 50px; -fx-max-width: 50px; -fx-max-height: 50px;" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        
                        <!-- Columna derecha: Puntos 4, 5, 6 -->
                        <CheckBox fx:id="chkPunto4" focusTraversable="false" style="-fx-min-width: 50px; -fx-min-height: 50px; -fx-max-width: 50px; -fx-max-height: 50px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <CheckBox fx:id="chkPunto5" focusTraversable="false" style="-fx-min-width: 50px; -fx-min-height: 50px; -fx-max-width: 50px; -fx-max-height: 50px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <CheckBox fx:id="chkPunto6" focusTraversable="false" style="-fx-min-width: 50px; -fx-min-height: 50px; -fx-max-width: 50px; -fx-max-height: 50px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <columnConstraints>
                     <ColumnConstraints />
                     <ColumnConstraints />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>
                    
                    <!-- Instrucciones de teclado -->
                    <VBox prefHeight="169.0" prefWidth="463.0" spacing="8.0" style="-fx-background-color: #E3F2FD; -fx-padding: 15px; -fx-background-radius: 5px;" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px;" text="🖱️  Click en puntos o Teclas 1-6: Activar/Desactivar" />
                        <Label style="-fx-font-size: 12px;" text="↵  ENTER: Confirmar y añadir símbolo" />
                        <Label style="-fx-font-size: 12px;" text="␣  ESPACIO: Insertar espacio" />
                        <Label style="-fx-font-size: 12px;" text="⌫  BACKSPACE: Borrar último símbolo" />
                    </VBox>
                </HBox>
                
                <!-- SECCIÓN 2: Símbolos Braille Ingresados -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Símbolos Braille ingresados:" />
                <TextArea fx:id="textoBrailleIngresado" editable="false" prefRowCount="4" style="-fx-font-size: 24px; -fx-font-family: 'Segoe UI Symbol', 'Arial Unicode MS', 'DejaVu Sans'; -fx-control-inner-background: #FAFAFA;" wrapText="true" />
                
                <!-- Botones de acción -->
                <HBox alignment="CENTER" spacing="10.0">
                    <Button fx:id="btnLimpiarBraille" focusTraversable="false" onAction="#limpiarBrailleIngresado" style="-fx-font-size: 14px; -fx-padding: 10px 20px;" text="Limpiar" />
                    <Button fx:id="btnTraducirBraille" focusTraversable="false" onAction="#traducirBrailleIngresado" style="-fx-font-size: 14px; -fx-padding: 10px 20px; -fx-background-color: #2196F3; -fx-text-fill: white;" text="Traducir a Español" />
                </HBox>
                
                <!-- SECCIÓN 3: Resultado en Español -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Resultado (Español):" />
                <TextArea fx:id="textoResultadoEspanol" editable="false" prefRowCount="4" style="-fx-control-inner-background: #F0F0F0; -fx-font-size: 16px;" wrapText="true" />
            </VBox>
        </Tab>
    </TabPane>
</VBox>
